<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that does not need the game: the Archipelago connection, which check belongs
       to which event, what the player holds, and reading game objects by member name. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>MegabonkAP.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="checks.json" LogicalName="checks.json" />
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
  </ItemGroup>

</Project>
