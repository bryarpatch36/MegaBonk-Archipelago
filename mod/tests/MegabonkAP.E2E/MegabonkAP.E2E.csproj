<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plays a slot on a real Archipelago server through the mod's own connection and check
       logic, with no game. Started by tests/e2e_mod_core.py. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MegabonkAP.Core\MegabonkAP.Core.csproj" />
  </ItemGroup>

</Project>
