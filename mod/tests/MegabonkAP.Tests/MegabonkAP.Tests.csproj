<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs without the game and without a server: the check logic against a stand-in server,
       and the game reading against stand-in classes that carry the game's member names. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1902;NU1903;CS0649;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <ProjectReference Include="..\..\src\MegabonkAP.Core\MegabonkAP.Core.csproj" />
  </ItemGroup>

</Project>
